{
  "configById": {
    "Tab!orca": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "感知 · gate",
          "layout": {
            "first": {
              "first": "Image!front",
              "second": "Image!detections",
              "direction": "column",
              "splitPercentage": 50
            },
            "second": {
              "first": "Plot!gate_distance",
              "second": {
                "first": "StateTransitions!gate_flags",
                "second": "RawMessages!gate_obj",
                "direction": "column",
                "splitPercentage": 42
              },
              "direction": "column",
              "splitPercentage": 40
            },
            "direction": "row",
            "splitPercentage": 45
          }
        },
        {
          "title": "任務進度",
          "layout": {
            "first": {
              "first": "StateTransitions!mission",
              "second": "Plot!mission_time",
              "direction": "column",
              "splitPercentage": 65
            },
            "second": {
              "first": "Image!detections_m",
              "second": "RawMessages!status",
              "direction": "column",
              "splitPercentage": 45
            },
            "direction": "row",
            "splitPercentage": 58
          }
        },
        {
          "title": "控制 · 深度 PID",
          "layout": {
            "first": {
              "first": "Plot!depth_track",
              "second": "Plot!pid_force",
              "direction": "column",
              "splitPercentage": 62
            },
            "second": {
              "first": "Plot!wrench_bus",
              "second": "Plot!thrusters",
              "direction": "column",
              "splitPercentage": 50
            },
            "direction": "row",
            "splitPercentage": 50
          }
        },
        {
          "title": "賽後回放",
          "layout": {
            "first": {
              "first": "Image!front_r",
              "second": "Image!depth_r",
              "direction": "row",
              "splitPercentage": 50
            },
            "second": {
              "first": "StateTransitions!replay",
              "second": {
                "first": "Plot!depth_replay",
                "second": "RawMessages!status_replay",
                "direction": "row",
                "splitPercentage": 55
              },
              "direction": "column",
              "splitPercentage": 42
            },
            "direction": "column",
            "splitPercentage": 42
          }
        }
      ]
    },

    "Image!front": {
      "imageMode": {
        "imageTopic": "/orca/record/front/compressed"
      }
    },
    "Image!detections": {
      "imageMode": {
        "imageTopic": "/orca/record/detections/compressed"
      }
    },
    "Plot!gate_distance": {
      "paths": [
        {
          "value": "/orca/perception_array.objects[:]{label==\"gate\"}.distance",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "gate distance (m) — -1 代表深度被拒絕",
          "color": "#4e9a06"
        },
        {
          "value": "/orca/perception_array.objects[:]{label==\"gate\"}.confidence",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "confidence",
          "color": "#c4a000"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "isSynced": true,
      "xAxisVal": "timestamp"
    },
    "StateTransitions!gate_flags": {
      "paths": [
        {
          "value": "/orca/perception_array.objects[:]{label==\"gate\"}.valid",
          "timestampMethod": "receiveTime",
          "label": "gate valid（單幀深度可信）"
        },
        {
          "value": "/orca/perception_array.objects[:]{label==\"gate\"}.is_stable",
          "timestampMethod": "receiveTime",
          "label": "gate is_stable（進得了世界模型）"
        },
        {
          "value": "/orca/decision/status.current_action",
          "timestampMethod": "receiveTime",
          "label": "BT 節點"
        }
      ],
      "isSynced": true
    },
    "RawMessages!gate_obj": {
      "topicPath": "/orca/perception_array.objects[:]{label==\"gate\"}",
      "fontSize": 12,
      "defaultExpanded": true
